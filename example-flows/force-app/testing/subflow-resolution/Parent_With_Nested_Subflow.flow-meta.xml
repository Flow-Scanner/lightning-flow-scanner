<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <description>Parent flow with nested subflow chain: Parent -> Middle_Flow -> Child_With_DML. Tests recursive subflow resolution for DML-in-loop detection.</description>
    <label>Parent With Nested Subflow</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <interviewLabel>Parent With Nested Subflow {!$Flow.CurrentDateTime}</interviewLabel>
    <runInMode>DefaultMode</runInMode>

    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Get_Accounts</targetReference>
        </connector>
    </start>

    <recordLookups>
        <name>Get_Accounts</name>
        <label>Get Accounts</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <connector>
            <targetReference>Loop_Accounts</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Customer</stringValue>
            </value>
        </filters>
        <object>Account</object>
        <outputReference>AccountCollection</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
    </recordLookups>

    <variables>
        <name>AccountCollection</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>

    <variables>
        <name>CurrentAccount</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>

    <loops>
        <name>Loop_Accounts</name>
        <label>Loop Accounts</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <collectionReference>AccountCollection</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Call_Middle_Flow</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>End_Flow</targetReference>
        </noMoreValuesConnector>
        <assignNextValueToReference>CurrentAccount</assignNextValueToReference>
    </loops>

    <subflows>
        <name>Call_Middle_Flow</name>
        <label>Call Middle Flow</label>
        <locationX>264</locationX>
        <locationY>398</locationY>
        <connector>
            <targetReference>Loop_Accounts</targetReference>
        </connector>
        <flowName>Middle_Flow</flowName>
        <inputAssignments>
            <name>InputAccountId</name>
            <value>
                <elementReference>CurrentAccount.Id</elementReference>
            </value>
        </inputAssignments>
    </subflows>

    <assignments>
        <name>End_Flow</name>
        <label>End Flow</label>
        <locationX>176</locationX>
        <locationY>518</locationY>
        <assignmentItems>
            <assignToReference>CurrentAccount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>CurrentAccount</elementReference>
            </value>
        </assignmentItems>
    </assignments>
</Flow>
